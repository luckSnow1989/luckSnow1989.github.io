{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Spring Cloud 8 阶段工作流自动化配置",
  "_version": "1.0.0",
  "_author": "Mavis (AI Coding Frameworks Toolkit v3.0)",

  "permissions": {
    "allow": [
      "Bash(mvn test*)",
      "Bash(mvn -pl *)",
      "Bash(mvn -am *)",
      "Bash(git worktree *)",
      "Bash(git checkout -b feature/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.claude/hooks/stage-tracker.py",
            "_description": "Hook 1: 检测用户输入,自动激活对应阶段的 skill,推进状态机"
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.claude/hooks/doc-validator.py",
            "_description": "Hook 2 (Pre): 写入文档前检查路径是否在 .history/ 目录"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.claude/hooks/doc-validator.py",
            "_description": "Hook 2 (Post): 写入 0X-*.md 模板后,自动验证必填字段完整性"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python $CLAUDE_PROJECT_DIR/.claude/hooks/coverage-check.py",
            "_description": "Hook 3: mvn test 跑完后自动检查 JaCoCo 覆盖率,达标才能进 review"
          }
        ]
      }
    ],

    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔔 阶段切换提示: 详见 .claude/hooks/stage-tracker.py'"
          }
        ]
      }
    ]
  },

  "commands": {
    "_comment": "自定义 slash command 目录(项目级别)",
    "_doc": "文件放在 .claude/commands/ 下,如 .claude/commands/req-full.md"
  },

  "stateFiles": {
    "_comment": "状态文件路径",
    "stageTracker": "/tmp/req-state.json",
    "coverageCache": "/tmp/coverage-cache.json"
  },

  "automation": {
    "_comment": "自动化配置(可调)",
    "checkpointStages": [0, 3, 6, 7],
    "_checkpointStages_doc": "这 4 个阶段必须人工确认:0 需求 / 3 Worktree / 6 Review / 7 收尾",
    "autoStopOnCoverageFail": true,
    "_autoStopOnCoverageFail_doc": "覆盖率不达标时,提示但不阻断(允许补测试)",
    "maxBrainstormRounds": 15,
    "_maxBrainstormRounds_doc": "阶段 0 最多问 15 轮,超过提示用户简化"
  }
}
